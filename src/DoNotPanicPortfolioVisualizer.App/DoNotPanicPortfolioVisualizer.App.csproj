<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoNotPanicPortfolioVisualizer.Presentation\DoNotPanicPortfolioVisualizer.Presentation.csproj" />
    <ProjectReference Include="..\DoNotPanicPortfolioVisualizer.Data\DoNotPanicPortfolioVisualizer.Data.csproj" />
    <ProjectReference Include="..\DoNotPanicPortfolioVisualizer.Shared\DoNotPanicPortfolioVisualizer.Shared.csproj" />
    <ProjectReference Include="..\YFinance\YFinance.NET.Server\YFinance.NET.Server.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyYFinanceServerForBuild" AfterTargets="Build">
    <ItemGroup>
      <YFinanceServerBuildFiles Include="..\YFinance\YFinance.NET.Server\bin\$(Configuration)\net10.0\**\*"
                                Exclude="..\YFinance\YFinance.NET.Server\bin\$(Configuration)\net10.0\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(YFinanceServerBuildFiles)"
          DestinationFiles="@(YFinanceServerBuildFiles->'$(TargetDir)YFinanceServer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishYFinanceServerBundle"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\YFinance\YFinance.NET.Server\YFinance.NET.Server.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)YFinanceServer\" />
  </Target>
</Project>
