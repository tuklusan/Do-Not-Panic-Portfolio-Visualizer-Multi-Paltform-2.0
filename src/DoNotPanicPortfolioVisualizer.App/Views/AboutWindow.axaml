<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoNotPanicPortfolioVisualizer.App.Views.AboutWindow"
        Title="About DO NOT PANIC PORTFOLIO VISUALIZER 2.0"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F1418">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            BorderBrush="#284960"
            BorderThickness="1"
            Background="#131C23"
            Padding="12"
            Margin="0,0,0,18">
      <Image Source="avares://DoNotPanicPortfolioVisualizer.App/Assets/dnppv-icon.ico"
             Stretch="Uniform"
             Height="120" />
    </Border>

    <Border Grid.Row="1"
            Background="#171F26"
            BorderBrush="#233948"
            BorderThickness="1"
            Padding="18">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER 2.0"
                     Foreground="White"
                     FontSize="26"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding VersionText}"
                     Foreground="#A7C4DB"
                     FontSize="14"
                     Margin="0,0,0,8" />
          <TextBlock Text="{Binding PublisherText}" Foreground="#E5EDF4" FontSize="15" />
          <TextBlock Text="{Binding AuthorText}" Foreground="#E5EDF4" FontSize="15" />
          <TextBlock Text="{Binding LicenseText}"
                     Foreground="#E5EDF4"
                     FontSize="15"
                     Margin="0,0,0,8" />
          <TextBlock Text="DO NOT PANIC PORTFOLIO VISUALIZER is a decorative desktop market visualizer with animated ticker tapes, macro and world-market ribbons, graph cards, finance-news flavor text, and rotating exchange/city backgrounds. It is for ambient information and entertainment only: it absolutely must not be used as a financial planning, trading, alerting, advice, portfolio-monitoring, or decision-support tool."
                     Foreground="#C9D8E4"
                     TextWrapping="Wrap"
                     FontSize="14"
                     Margin="0,0,0,10" />
          <TextBlock Text="License Text"
                     Foreground="White"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <Border Background="#10171D"
                  BorderBrush="#284960"
                  BorderThickness="1"
                  Padding="12">
            <TextBlock Text="{Binding FullLicenseText}"
                       Foreground="#C9D8E4"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="2"
            Content="OK"
            Width="110"
            Padding="16,7"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            IsDefault="True"
            IsCancel="True"
            Click="OnOkClick" />
  </Grid>
</Window>
