<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DoNotPanicPortfolioVisualizer.App.Converters"
        x:Class="DoNotPanicPortfolioVisualizer.App.Views.ProductShellWindow"
        x:Name="ShellWindow"
        x:CompileBindings="False"
        Title="DO NOT PANIC PORTFOLIO VISUALIZER 2.0"
        Icon="/Assets/dnppv-icon.ico"
        WindowState="Maximized"
        MinWidth="960"
        MinHeight="600"
        Background="#111315"
        Opened="OnWindowOpened"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown"
        DoubleTapped="OnWindowDoubleTapped">
    <Window.Resources>
        <converters:BackgroundImageConverter x:Key="BackgroundImageConverter" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,*">
        <Menu x:Name="MainMenu"
              Grid.Row="0"
              Background="#171B1F"
              Foreground="#E7EDF2">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="FullScreenMenuItem"
                          Header="_Full Screen"
                          InputGesture="F11"
                          Click="OnFullScreenClick" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings" Click="OnSettingsClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Grid x:Name="SceneRoot" Grid.Row="1" SizeChanged="OnSceneRootSizeChanged">
            <Image Source="{Binding BackgroundSourceA, Converter={StaticResource BackgroundImageConverter}}"
                   Stretch="Fill"
                   Opacity="{Binding BackgroundOpacityA}"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="{Binding BackgroundScaleA}" ScaleY="{Binding BackgroundScaleA}" />
                </Image.RenderTransform>
            </Image>
            <Image Source="{Binding BackgroundSourceB, Converter={StaticResource BackgroundImageConverter}}"
                   Stretch="Fill"
                   Opacity="{Binding BackgroundOpacityB}"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="{Binding BackgroundScaleB}" ScaleY="{Binding BackgroundScaleB}" />
                </Image.RenderTransform>
            </Image>
            <Border Background="Black" Opacity="{Binding SceneDimOpacity}" />

            <ItemsControl ItemsSource="{Binding Graphs}"
                          IsHitTestVisible="False"
                          Margin="16,12,16,10"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="186"
                                Height="78"
                                Background="#C20D131B"
                                BorderBrush="{Binding AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="7">
                            <Grid>
                                <Border Background="{Binding FlashBrush}"
                                        Opacity="{Binding FlashOpacity}"
                                        CornerRadius="5" />
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="34,*,42,46">
                                        <TextBlock Text="{Binding Symbol}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="White" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OverlayText}"
                                                   Margin="2,1"
                                                   FontSize="7"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#8EA4B4" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LastText}"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="Consolas"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="White" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ChangeText}"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="Consolas"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding AccentBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="30,*" Margin="0,3,0,0">
                                        <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,5,0">
                                            <TextBlock Text="{Binding MaxScaleText}"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Consolas"
                                                       FontSize="7"
                                                       Foreground="#90B0C9" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding MidScaleText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="7"
                                                       Foreground="#7E9AB0" />
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding MinScaleText}"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Consolas"
                                                       FontSize="7"
                                                       Foreground="#90B0C9" />
                                        </Grid>
                                        <Grid Grid.Column="1" Width="132" Height="40">
                                            <Border BorderBrush="#37AFC6D8" BorderThickness="1" />
                                            <Path Data="{Binding PathData}"
                                                  Stroke="{Binding AccentBrush}"
                                                  StrokeThickness="1.5"
                                                  Stretch="Fill"
                                                  Margin="1,1,1,9" />
                                            <Grid VerticalAlignment="Bottom"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  Margin="2,0">
                                                <TextBlock Text="{Binding LeftTimeScaleText}"
                                                           FontFamily="Consolas"
                                                           FontSize="6"
                                                           Foreground="#93A9BD" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MiddleTimeScaleText}"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="6"
                                                           Foreground="#93A9BD" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RightTimeScaleText}"
                                                           FontFamily="Consolas"
                                                           FontSize="6"
                                                           Foreground="#93A9BD" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="16,12,16,10"
                  RowDefinitions="Auto,Auto,*,Auto,Auto"
                  RowSpacing="10">
                <Grid ColumnDefinitions="248,Auto,*" MinHeight="52">
                    <StackPanel Width="248" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding MarketStatusText}"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F7F8" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   Width="222"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#DCE6ED" />
                        <TextBlock Text="{Binding DataFreshnessText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{Binding FreshnessBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#D91A2B38"
                            BorderBrush="#5790B2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="26,7">
                        <TextBlock Text="SANYALnet Labs  DO NOT PANIC Portfolio Visualizer"
                                   FontSize="18"
                                   Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                MinWidth="102"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockDateText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   Foreground="#9DB1C0" />
                        <TextBlock Text="{Binding ClockText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="White" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,2,0,0"
                        MinHeight="60"
                        Background="#B7191D21"
                        BorderBrush="#46515A"
                        BorderThickness="1"
                        Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="MACRO MARKETS"
                                   FontFamily="Consolas"
                                   Foreground="#AFC6D8" />
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding MacroQuotes}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#AA1A2128"
                                            BorderBrush="#4C5B68"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Width="96"
                                            Height="50"
                                            Padding="7,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="9"
                                                       Foreground="#AFC6D8" />
                                            <TextBlock Text="{Binding ValueText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="White" />
                                            <TextBlock Text="{Binding ChangeText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="{Binding AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" ClipToBounds="True">
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding Lanes}"
                                  Margin="8,12,8,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E8050607"
                                    BorderBrush="#332E3A47"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Background="#FF121922"
                                            BorderBrush="#5546637A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9AB5C8" />
                                    </Border>
                                    <Border Grid.Column="1" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding TrackItems}"
                                                  Width="{Binding TrackWidth}"
                                                  HorizontalAlignment="Left">
                                        <ItemsControl.RenderTransform>
                                            <TranslateTransform X="{Binding TrackOffset}" />
                                        </ItemsControl.RenderTransform>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="{Binding Width}" ColumnDefinitions="62,64,72,*">
                                                    <Border Grid.ColumnSpan="3"
                                                            Background="{Binding Quote.FlashBrush}"
                                                            Opacity="{Binding Quote.FlashOpacity}"
                                                            CornerRadius="4" />
                                                    <TextBlock Text="{Binding Quote.DisplayName}"
                                                               FontFamily="Consolas"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Quote.TrendBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Quote.PriceText}"
                                                               FontFamily="Consolas"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="#F3F6F8" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Quote.ChangeText}"
                                                               FontFamily="Consolas"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Quote.TrendBrush}" />
                                                    <Border Grid.Column="3"
                                                            Width="1"
                                                            Height="16"
                                                            Margin="9,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="#5A768B9F" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Row="3"
                        Background="#E20B1116"
                        BorderBrush="#314B5F"
                        BorderThickness="1"
                        Padding="0">
                    <Grid ColumnDefinitions="120,158,*" Height="68">
                        <Border Background="#F0162A3A"
                                BorderBrush="#445C90AA"
                                BorderThickness="0,0,1,0"
                                Padding="11,8">
                            <TextBlock Text="GLOBAL MARKETS"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       Foreground="#EAF7FF" />
                        </Border>

                        <Border Grid.Column="1"
                                DataContext="{Binding PinnedGlobalMarket}"
                                Width="150"
                                Height="54"
                                Margin="8,0,0,0"
                                Padding="6,3"
                                VerticalAlignment="Center"
                                Background="#C2171D22"
                                BorderBrush="#405564"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding City}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#C9E8FF" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TimeText}"
                                               FontFamily="Consolas"
                                               FontSize="8"
                                               Foreground="#DCE6ED" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ExchangeName}"
                                               FontSize="8"
                                               Foreground="#8EA4B4" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SessionText}"
                                               FontSize="7"
                                               Foreground="#AFC0CB" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                                    <TextBlock Text="{Binding ValueText}"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               Foreground="White" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ChangeText}"
                                               Margin="5,0,0,0"
                                               FontFamily="Consolas"
                                               FontSize="8"
                                               Foreground="{Binding AccentBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding WeatherText}"
                                               HorizontalAlignment="Right"
                                               FontSize="8"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#AFC0CB" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2"
                              Height="68"
                              Margin="16,0,28,0"
                              ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding GlobalMarketTrackItems}"
                                          Width="{Binding GlobalMarketsTrackWidth}"
                                          HorizontalAlignment="Left">
                                <ItemsControl.RenderTransform>
                                    <TranslateTransform X="{Binding GlobalMarketsTrackOffset}" />
                                </ItemsControl.RenderTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="164"
                                            Height="54"
                                            Margin="0,7,14,7"
                                            Background="#C2171D22"
                                            BorderBrush="#405564"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,3">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding City}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="#C9E8FF" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TimeText}"
                                                           FontFamily="Consolas"
                                                           FontSize="8"
                                                           Foreground="#DCE6ED" />
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ExchangeName}"
                                                       FontSize="8"
                                                       Foreground="#8EA4B4" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SessionText}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="7"
                                                       Foreground="#AFC0CB" />
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                                                <TextBlock Text="{Binding ValueText}"
                                                           FontFamily="Consolas"
                                                           FontSize="9"
                                                           Foreground="White" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ChangeText}"
                                                           Margin="5,0,0,0"
                                                           FontFamily="Consolas"
                                                           FontSize="8"
                                                           Foreground="{Binding AccentBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding WeatherText}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="8"
                                                           Foreground="#AFC0CB" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Width="72"
                                    HorizontalAlignment="Left"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#E20B1116" Offset="0" />
                                        <GradientStop Color="#000B1116" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="36"
                                    HorizontalAlignment="Right"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#000B1116" Offset="0" />
                                        <GradientStop Color="#E20B1116" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" RowDefinitions="Auto,Auto">
                    <Border Height="54" Background="#E2040506" Padding="0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="#E51D2C" Padding="16,10">
                                <TextBlock Text="FINANCE NEWS"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <Border Grid.Column="1"
                                    Height="44"
                                    Margin="12,0,10,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <TextBlock Text="{Binding NewsText}"
                                           MaxHeight="38"
                                           LineHeight="19"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#EEF2F4"
                                           TextWrapping="Wrap">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="{Binding NewsVerticalOffset}" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,5,0,0">
                        <TextBlock Text="© Supratim Sanyal, SANYALnet Labs."
                                   FontSize="10"
                                   Foreground="#88939A" />
                        <TextBlock Grid.Column="1"
                                   Text="Delayed market data may apply."
                                   FontSize="10"
                                   Foreground="#88939A" />
                        <TextBlock Grid.Column="2"
                                   Text="2.0"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#88939A" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
