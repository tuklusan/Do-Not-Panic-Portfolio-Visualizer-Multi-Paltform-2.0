<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoNotPanicPortfolioVisualizer.App.Views.ProductShellWindow"
        x:Name="ShellWindow"
        x:CompileBindings="False"
        Title="DO NOT PANIC PORTFOLIO VISUALIZER 2.0"
        Icon="/Assets/dnppv-icon.ico"
        WindowState="Maximized"
        MinWidth="960"
        MinHeight="600"
        Background="#111315"
        Opened="OnWindowOpened"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown"
        DoubleTapped="OnWindowDoubleTapped">
    <Grid RowDefinitions="Auto,*">
        <Menu x:Name="MainMenu"
              Grid.Row="0"
              Background="#171B1F"
              Foreground="#E7EDF2">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="FullScreenMenuItem"
                          Header="_Full Screen"
                          InputGesture="F11"
                          Click="OnFullScreenClick" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings" Click="OnSettingsClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Grid x:Name="SceneRoot" Grid.Row="1">
            <Image Source="/Assets/ExchangeBackgrounds/new-york-stock-exchange.jpg"
                   Stretch="UniformToFill" />
            <Border Background="#990B0D0F" />

            <Grid Margin="16,12,16,10"
                  RowDefinitions="Auto,Auto,*,Auto,Auto"
                  RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding MarketStatusText}"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F7F8" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#DCE6ED" />
                        <TextBlock Text="{Binding DataFreshnessText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{Binding FreshnessBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#D91A2B38"
                            BorderBrush="#5790B2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="26,7">
                        <TextBlock Text="SANYALnet Labs  DO NOT PANIC Portfolio Visualizer"
                                   FontSize="18"
                                   Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockDateText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   Foreground="#9DB1C0" />
                        <TextBlock Text="{Binding ClockText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="White" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,2,0,0"
                        Background="#B7191D21"
                        BorderBrush="#46515A"
                        BorderThickness="1"
                        Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="MACRO MARKETS"
                                   FontFamily="Consolas"
                                   Foreground="#AFC6D8" />
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding MacroQuotes}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#AA1A2128"
                                            BorderBrush="#4C5B68"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Width="92"
                                            Padding="7,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="9"
                                                       Foreground="#AFC6D8" />
                                            <TextBlock Text="{Binding ValueText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="White" />
                                            <TextBlock Text="{Binding ChangeText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="{Binding AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding Lanes}"
                              Margin="8,34,8,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E8050607"
                                    BorderBrush="#332E3A47"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Background="#FF121922"
                                            BorderBrush="#5546637A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9AB5C8" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Quotes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="13" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="Consolas"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TrendBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PriceText}"
                                                               FontFamily="Consolas"
                                                               Foreground="#F3F6F8" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ChangeText}"
                                                               FontFamily="Consolas"
                                                               Foreground="{Binding TrendBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3"
                        Background="#E20B1116"
                        BorderBrush="#314B5F"
                        BorderThickness="1"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="GLOBAL MARKETS"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="#C9E8FF" />
                        <TextBlock Grid.Column="1"
                                   Text="World-market clocks and weather are initializing"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"
                                   Foreground="#AFC0CB" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" RowDefinitions="Auto,Auto">
                    <Border Background="#E2040506" Padding="0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="#E51D2C" Padding="16,10">
                                <TextBlock Text="FINANCE NEWS"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Loading France 24 business headlines..."
                                       Margin="14,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       Foreground="#EEF2F4" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,5,0,0">
                        <TextBlock Text="© Supratim Sanyal, SANYALnet Labs."
                                   FontSize="10"
                                   Foreground="#88939A" />
                        <TextBlock Grid.Column="1"
                                   Text="Delayed market data may apply."
                                   FontSize="10"
                                   Foreground="#88939A" />
                        <TextBlock Grid.Column="2"
                                   Text="2.0"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#88939A" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
