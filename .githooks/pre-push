set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-push.ps1" "$@"
fi

if command -v powershell >/dev/null 2>&1; then
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-push.ps1" "$@"
fi

echo "Neither pwsh nor powershell is available for the DNPPV pre-push hook." 1>&2
exit 1
